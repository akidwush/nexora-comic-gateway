{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexora-comic-gateway-pilot",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "ENABLE_IMAGE_DELIVERY": "false"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/fixture/*",
      "/v1/*"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
